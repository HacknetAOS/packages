# Maintainer: HacknetAOS <hacknetaos@users.noreply.github.com>
pkgname=hacknet-settings
pkgver=0.2.0
pkgrel=1
pkgdesc="Modular GTK4 system, desktop, theme, input, and keybind settings application for HacknetOS"
arch=(any)
url="https://github.com/HacknetAOS/hacknet-settings"
license=(GPL-3.0-or-later)
depends=(python python-gobject gtk4 hacknetctl hacknet-theme)
source=()
sha256sums=()

_find_settings_dir() {
    for d in "${HACKNET_SRC:-}/hacknet-settings" "${HACKNET_SRC:-}" "$startdir/../../hacknet-settings"; do
        if [ -n "$d" ] && [ -d "$d/hacknet_settings" ]; then
            echo "$d"
            return 0
        fi
    done
    echo "."
}

package() {
    local sdir sitedir
    sdir="$(_find_settings_dir)"
    sitedir="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"

    install -Dm755 "$sdir/bin/hacknet-settings" "$pkgdir/usr/bin/hacknet-settings"
    install -Dm644 "$sdir/data/hacknet-settings.desktop" "$pkgdir/usr/share/applications/hacknet-settings.desktop"
    install -Dm644 "$sdir/data/style.css" "$pkgdir/usr/share/hacknet-settings/style.css"
    install -Dm644 "$sdir/README.md" "$pkgdir/usr/share/doc/hacknet-settings/README.md"
    install -Dm644 "$sdir/LICENSE" "$pkgdir/usr/share/licenses/hacknet-settings/LICENSE"

    find "$sdir/hacknet_settings" -type f -name '*.py' | while read -r pyfile; do
        rel="${pyfile#"$sdir"/}"
        install -Dm644 "$pyfile" "$pkgdir/$sitedir/$rel"
    done
}
